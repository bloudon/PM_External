# Server-side only. Fill in /etc/permitsmanager/marketing-api.env on the VPS,
# never in Git, browser code, shell arguments, VITE_* or NEXT_PUBLIC_* variables.
HOST=127.0.0.1
PORT=5000
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
# These are SMTP2GO SMTP credentials, NOT your dashboard login.
SMTP_USER="YOUR_SMTP2GO_USERNAME"
SMTP_PASS="YOUR_SMTP2GO_SMTP_PASSWORD"
# One bare email address each. From must be verified in SMTP2GO.
SMTP_FROM="YOUR_VERIFIED_SENDER_EMAIL"
# Confirm the inbox for website submissions; it need not match From.
SMTP_TO="YOUR_DESTINATION_INBOX"
