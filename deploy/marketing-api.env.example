# OPTIONAL LEGACY API EXAMPLE — not needed for the static-site launch.
# The current API requires DATABASE_URL and does not deliver SMTP email yet.
# Do not install/start it for SMTP forms until that implementation is replaced.
# Keep actual credentials outside Git in /etc/permitsmanager/marketing-api.env.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE
