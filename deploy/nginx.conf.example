# Standalone marketing-site host. Install as a separate Nginx site file;
# do not replace the existing permitflow.conf app/pflow configuration.
# This root matches the administrator shell prompt ~/apps/PM_External.
# Confirm with `pwd` on the VPS and update the absolute path if different.
server {
    listen 80;
    listen [::]:80;
    server_name permitsmanager.com www.permitsmanager.com;

    root /home/administrator/apps/PM_External/artifacts/permits-manager-site/dist/public;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:5000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
