# Static-only marketing-site host. Install as a separate Nginx site file;
# do not replace the existing permitflow.conf app/pflow configuration.
# This root matches the administrator shell prompt ~/apps/PM_External.
# Confirm with `pwd` on the VPS and update the absolute path if different.
server {
    listen 80;
    listen [::]:80;
    server_name permitsmanager.com www.permitsmanager.com;

    root /home/administrator/apps/PM_External/artifacts/permits-manager-site/dist/public;
    index index.html;

    location /api/ {
        # Do not serve index.html or report success for an undelivered form.
        # Replace this location with the optional proxy snippet ONLY after
        # the SMTP handler is configured and verified on this VPS.
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"Email submissions are not configured yet."}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
