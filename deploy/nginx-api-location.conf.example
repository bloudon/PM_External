# OPTIONAL: replace the location /api/ block in the marketing host with this.
# Do not install this location-only snippet directly into sites-enabled.
# First implement SMTP delivery: the current API still uses a database.
# Keep port 5000 consistent with marketing-api.env and check-api-port.sh.
location /api/ {
    proxy_pass http://127.0.0.1:5000/api/;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
